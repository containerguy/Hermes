# Matchdesk (Mitspielzentrale). Bis v1.0 werden auch die alten Namen HERMES_* gelesen;
# beim Umstellen dieselben Werte übernehmen (vor allem *_SECRET), sonst sind Logins ungültig.
MATCHDESK_DB_PATH=./data/matchdesk.sqlite
MATCHDESK_PORT=3000
# In production behind HTTPS, set this to true so cookies are marked Secure.
# In local dev (http://localhost) keep it false.
MATCHDESK_COOKIE_SECURE=false

# CSRF token signing secret for cookie-authenticated mutations.
# Matchdesk uses a dev fallback if unset; set a strong random value in production.
MATCHDESK_CSRF_SECRET=change-me

# HMAC secret for stored device keys (device recognition / persistent device names).
# Set once to a strong random value and keep it stable: changing it makes every
# known device unrecognized (users keep their sessions but devices get new names).
MATCHDESK_DEVICE_KEY_SECRET=change-me

# Session idle timeout in days (1-400, default 180). Every use extends the session again,
# so active users stay signed in; unused sessions expire after this many days.
# MATCHDESK_SESSION_TTL_DAYS=180

# Optional: URL shown in the app footer as “source repository” (default: upstream repository on GitHub).
# MATCHDESK_SOURCE_REPO_URL=https://github.com/containerguy/Matchdesk

# Storage backend. Settings and app data live in SQLite; S3 stores/restores the SQLite snapshot.
MATCHDESK_STORAGE_BACKEND=s3
MATCHDESK_S3_BUCKET=matchdesk-storage
MATCHDESK_S3_REGION=eu-central-2
MATCHDESK_S3_ENDPOINT=https://s3.eu-central-2.wasabisys.com
MATCHDESK_S3_CREDS_FILE=./s3.creds
MATCHDESK_S3_DB_KEY=matchdesk.sqlite
MATCHDESK_S3_RESTORE_MODE=if-missing

# Used once during bootstrap or whenever the main admin should be ensured.
# Login uses MATCHDESK_ADMIN_USERNAME; the phone number remains profile data only.
MATCHDESK_ADMIN_PHONE=+491700000000
MATCHDESK_ADMIN_USERNAME=admin
MATCHDESK_ADMIN_EMAIL=admin@example.test

# Mail delivery for login codes. Use "console" only for local development.
# The sender address comes from MATCHDESK_MAIL_FROM; the display name follows the
# app name from the admin settings (same as the UI header).
MATCHDESK_MAIL_MODE=smtp
MATCHDESK_MAIL_FROM=Mitspielzentrale <matchdesk@example.test>
# Optional: public base URL of the app, used for the link in system emails.
# Without it, emails contain no link (request headers are not trusted).
MATCHDESK_PUBLIC_URL=
MATCHDESK_SMTP_HOST=smtp.example.test
MATCHDESK_SMTP_PORT=587
MATCHDESK_SMTP_SECURE=false
MATCHDESK_SMTP_SECURITY=starttls
MATCHDESK_SMTP_USER=
MATCHDESK_SMTP_PASSWORD=

# Web Push. Generate with: npx web-push generate-vapid-keys
MATCHDESK_VAPID_SUBJECT=mailto:admin@example.test
MATCHDESK_VAPID_PUBLIC_KEY=
MATCHDESK_VAPID_PRIVATE_KEY=

# Optional local test override. Do not set this in production.
# MATCHDESK_DEV_LOGIN_CODE=123456

# CubeCoders AMP (Gameserver-Modul, Phase 15). Zugangsdaten liegen NUR hier, nie in app_settings.
# Dienstkonto in AMP mit minimaler Rolle (Instanzen sehen, Start/Stop, Konsole), ohne 2FA; nicht die Rolle "*".
MATCHDESK_AMP_USERNAME=
MATCHDESK_AMP_PASSWORD=
# Optional: Datei fuer das rotierende rememberMe-Token (0600), spart den Passwort-Login nach Neustarts.
# MATCHDESK_AMP_REMEMBER_TOKEN_FILE=./data/amp-remember.token
# PEM der CA, die das Zertifikat des AMP-Controllers ausgestellt hat (leer = System-Trust-Store).
# MATCHDESK_AMP_CA_FILE=./amp-ca.pem
# Auto-Start/Leerlauf-Stopp stellt der Admin in der Mitspielzentrale ein (Admin -> Betrieb -> CubeCoders AMP), nicht hier.
